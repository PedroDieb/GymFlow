GEMINI_API_KEY=
VITE_APP_ID=gymflow-app
VITE_BASE_PATH=/

# Firebase is optional but recommended for real cloud persistence.
# Enable Anonymous Authentication and Firestore in your Firebase project,
# then fill these values from Project settings > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Alternative single-value form:
# VITE_FIREBASE_CONFIG={"apiKey":"","authDomain":"","projectId":"","storageBucket":"","messagingSenderId":"","appId":""}
